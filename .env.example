# 模板本地开发：所有值都是占位符，devMock 会接管 FBInstant / fbq / 网络上报
# 集成进主项目时，这些值由主项目自己的 .env 提供（模板代码本身不依赖真值）

# API base（主项目用于 game/detail、analyse/upload、error/upload 等）
VITE_API_BASE_URL=https://api.example.com

# 图片 CDN 基址（GlobalStore.systemConfig.imageBaseUrl）
VITE_IMAGE_BASE_URL=https://cdn.example.com/images/

# Facebook
VITE_FB_PIXEL_ID=PLACEHOLDER_PIXEL_ID
VITE_FB_APP_ID=PLACEHOLDER_APP_ID

# Google Analytics
VITE_GA_ID=PLACEHOLDER_GA_ID

# 默认插页广告位（quiz 类型兜底；其他类型在游戏 manifest.adUnits 里声明）
VITE_FB_AD_UNIT_QUIZ_IOS=PLACEHOLDER_QUIZ_IOS
VITE_FB_AD_UNIT_QUIZ_ANDROID=PLACEHOLDER_QUIZ_ANDROID

# Banner / Rewarded video（可选，模板里都是 no-op）
VITE_FB_AD_UNIT_BANNER=PLACEHOLDER_BANNER
VITE_FB_AD_UNIT_REWARDED_IOS=PLACEHOLDER_REWARDED_IOS
VITE_FB_AD_UNIT_REWARDED_ANDROID=PLACEHOLDER_REWARDED_ANDROID
